<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/update_version" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#B8C8D2" android:layout_marginBottom="14dp" />
    <TextView android:id="@+id/update_check_step" style="@style/VcsUpdateStep" android:text="@string/vcs_update_step_check" />
    <TextView android:id="@+id/update_download_step" style="@style/VcsUpdateStep" android:text="@string/stat_download" />
    <TextView android:id="@+id/update_verify_step" style="@style/VcsUpdateStep" android:text="@string/vcs_update_step_verify" />
    <TextView android:id="@+id/update_install_step" style="@style/VcsUpdateStep" android:text="@string/vcs_update_step_install" />
    <ProgressBar android:id="@+id/update_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="18dp"
        android:max="100" android:progressTint="#5EEAD4" android:indeterminateTint="#5EEAD4" android:progressBackgroundTint="#243544" />
    <TextView android:id="@+id/update_bytes" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="#5EEAD4" android:layout_marginTop="8dp" android:gravity="end" />
    <TextView android:id="@+id/update_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="14sp" android:textColor="#FFFFFF" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp"
        android:accessibilityLiveRegion="polite" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="@string/vcs_update_flow_note" android:textSize="12sp" android:textColor="#8899AA" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:layout_marginTop="18dp">
        <TextView android:id="@+id/update_close" style="@style/VcsUpdateAction" android:background="@drawable/vcs_dialog_secondary_button"
            android:textColor="#E5F2F7" android:text="@string/vcs_update_hide" />
        <TextView android:id="@+id/update_action" style="@style/VcsUpdateAction" android:layout_marginStart="12dp"
            android:background="@drawable/vcs_dialog_primary_button" android:textColor="#02110F" android:text="@string/vcs_update_retry" />
    </LinearLayout>
</LinearLayout>
