<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/secured_browser_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/vcs_widget_vpn_router_vpn"
                android:textColor="#D7E8EE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text=">"
                android:textColor="#79D9E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_router_logo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/vcs_widget_vpn_router_title"
                android:scaleType="centerCrop"
                android:src="@drawable/shortcut_vpn_router" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text=">"
                android:textColor="#79D9E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/vcs_widget_vpn_router_hotspot"
                android:textColor="#D7E8EE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text=">"
                android:textColor="#79D9E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/vcs_widget_vpn_router_clients"
                android:textColor="#D7E8EE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/vcs_widget_vpn_router_tap_detail"
            android:textColor="#A8BDC6"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="92dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/secured_browser_widget_button"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingHorizontal="8dp"
        android:text="@string/vcs_widget_vpn_router_open_to_check"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
