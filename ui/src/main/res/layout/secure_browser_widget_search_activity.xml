<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/vcs_dialog_background"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vcs_widget_secured_browser_search_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vcs_widget_secured_browser_search_subtitle"
            android:textColor="#B8C8D2"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/secure_browser_url_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autofillHints=""
                android:background="@android:color/transparent"
                android:hint="@string/vcs_widget_secured_browser_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="textWebEditText|textNoSuggestions"
                android:maxLines="1"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#7D949E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/search_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/secured_browser_widget_button"
                android:contentDescription="@string/vcs_widget_secured_browser_search_submit"
                android:gravity="center"
                android:text=">"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
