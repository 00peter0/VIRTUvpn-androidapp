<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/secured_browser_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:id="@+id/widget_search_box"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/secure_browser_url_bar_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="@string/vcs_widget_secured_browser_search_hint"
            android:textColor="#D7E8EE"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/widget_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/secured_browser_widget_button"
            android:contentDescription="@string/vcs_widget_secured_browser_search_hint"
            android:gravity="center"
            android:text=">"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
