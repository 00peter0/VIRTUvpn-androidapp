<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/secured_browser_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/vcs_home_secure_browser"
            android:scaleType="centerInside"
            android:src="@drawable/shortcut_secured_browser" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/vcs_widget_secured_browser_status"
            android:textColor="#52FF8C"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="@string/vcs_widget_secured_browser_detail"
            android:textColor="#D7E8EE"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/secured_browser_widget_button"
        android:gravity="center"
        android:text="@string/vcs_widget_secured_browser_open"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
