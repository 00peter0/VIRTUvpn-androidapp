<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#06131A" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="135"
                android:endColor="#123A4F"
                android:startColor="#0B2733" />
            <stroke
                android:width="1dp"
                android:color="#7A5EEAD4" />
        </shape>
    </item>
    <item
        android:bottom="18dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#08FFFFFF"
                android:startColor="#30FFFFFF" />
        </shape>
    </item>
</layer-list>
