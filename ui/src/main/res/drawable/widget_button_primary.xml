<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#064A54" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="0"
                android:endColor="#22E27B"
                android:startColor="#1BA8FF" />
            <stroke
                android:width="1dp"
                android:color="#A8FFFFFF" />
        </shape>
    </item>
    <item
        android:bottom="19dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#22FFFFFF"
                android:startColor="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
